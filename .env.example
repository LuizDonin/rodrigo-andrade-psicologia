# Origem pública do site, sem caminho ou barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Caminho de publicação. Deixe vazio em domínio próprio ou use, por
# exemplo, /rodrigo-andrade-psicologia no GitHub Pages.
NEXT_PUBLIC_BASE_PATH=

# Ative somente no ambiente de produção aprovado, com URL HTTPS definitiva.
SITE_INDEXABLE=false
